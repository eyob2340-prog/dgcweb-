# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used for signing Admin JWT tokens.
JWT_SECRET="secure-random-jwt-secret-key-replace-in-production"

# TELEGRAM_BOT_TOKEN: Bot token obtained from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: Target Telegram channel or admin user Chat ID to receive reports.
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# DATABASE_URL: PostgreSQL / Supabase / Neon connection string.
DATABASE_URL="postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require"

# Initial Admin Credentials (used if no admin exists yet)
ADMIN_EMAIL="admin@dgc.gov.et"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"

