# DGC Web — Environment Variables Configuration
# Copy this file to .env and fill in your values.
# NEVER commit actual secrets to version control!

# Google Gemini AI API Keys
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_CUSTOMER_SERVICE_API_KEY="your_gemini_api_key_here"

# Application
APP_URL="http://localhost:3000"

# JWT Secret — MUST be a strong random string (min 64 chars) in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate_a_secure_random_string_here"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Initial Admin Credentials (used only for first-time database seeding)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="SecureAdminPassword123!"

# SMTP Email Configuration (for OTP delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Dire Dawa Public Survey <no-reply@dgc.gov.et>"

# ── Added: required / recommended for production ──
# Initial passwords for seeded accounts (must be changed on first login)
DEV_PASSWORD="change_me_strong_password"
OWNER_PASSWORD="change_me_strong_password"
# Optional extra developer account e-mail created at first start (uses ADMIN_PASSWORD)
# ADMIN_EMAIL="developer@dgc.gov.et"

# Secret used to anonymise citizen IP hashes. MUST stay constant between restarts.
ANONYMOUS_SALT="generate_another_64_char_random_string"

# Max survey submissions from one IP per survey per 24h (shared NAT friendly default)
MAX_SUBMISSIONS_PER_IP_PER_SURVEY="40"

# Render/hosting sets PORT automatically. Do not hard-code it.
# PORT="3000"

# PostgreSQL TLS: set the provider CA (PEM, use \n for newlines) then enable verification
# PG_SSL_CA=""
# PG_SSL_REJECT_UNAUTHORIZED="true"
